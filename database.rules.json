{
  "rules": {
    ".read": false,
    ".write": false,
    "transmitters": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('transmitters').child($uid).child('receivers').child(auth.uid).exists() || root.child('transmitters').child($uid).child('accessRequests').child(auth.uid).exists())",
        "syncCode": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "email": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "active": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "updatedAt": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "role": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "credentials": {
          ".read": "auth != null && (auth.uid == $uid || root.child('transmitters').child($uid).child('receivers').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid"
        },
        "smsRelay": {
          ".read": "auth != null && (auth.uid == $uid || root.child('transmitters').child($uid).child('receivers').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid"
        },
        "accessRequests": {
          "$reqId": {
            ".read": "auth != null && (auth.uid == $uid || auth.uid == $reqId)",
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $reqId)"
          }
        },
        "loginRequests": {
          "$reqId": {
            ".read": "auth != null && (auth.uid == $uid || auth.uid == $reqId)",
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $reqId)"
          }
        },
        "receivers": {
          "$receiverId": {
            ".read": "auth != null && (auth.uid == $uid || auth.uid == $receiverId)",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "pairing_codes": {
      "$kod": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "receiver_sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
